# Port the Express server listens on (default: 3020)
PORT=3020

# Secret key used to sign JWTs.
# REQUIRED: set this to a long random string before starting the server.
# The server will refuse to start if this is not set.
# Example: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret

# Allowed CORS origin (default: http://localhost:<PORT>)
# Set this when the frontend is served from a different host/port than the API.
# CORS_ORIGIN=http://localhost:3020

# Set to "production" to enable the Secure flag on the auth cookie (requires HTTPS).
# NODE_ENV=production
